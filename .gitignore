# =====================================================================
# .gitignore  -  Que se queda FUERA del repositorio
# ---------------------------------------------------------------------
# La regla es simple: nunca se sube nada que contenga una contraseña
# o que sea reproducible con un comando.
# =====================================================================

# Dependencias: se regeneran con `npm install`.
node_modules/

# Variables de entorno REALES. Sí se sube .env.example (sin secretos).
.env
.env.local
.env.*.local

# Logs y procesos
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.pid
*.seed

# Sistema y editores
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Salidas de pruebas generadas por Postman/Newman
newman-report.html
