# =====================================================================
# .env.example  -  Plantilla de variables de entorno
# ---------------------------------------------------------------------
# Plantilla PUBLICA. Copiala a .env y completa los valores reales:
#   cp .env.example .env
#
# ESTE archivo SI se sube a git; el .env (con las contraseñas reales)
# NO se sube: ya esta en el .gitignore.
# =====================================================================

# ---------- Servidor HTTP ----------
PUERTO=3000
NODE_ENV=development

# ---------- Base de datos MySQL ----------
DB_HOST=localhost
DB_PUERTO=3306
DB_USUARIO=cambia_este_usuario
DB_CLAVE=cambia_esta_clave
DB_NOMBRE=discoteca_api

# Numero maximo de conexiones simultaneas en el pool.
DB_LIMITE_CONEXIONES=10

# ---------- CORS ----------
# Origenes del frontend autorizados a consumir la API, separados por coma.
ORIGENES_PERMITIDOS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# ---------- Autenticación (JWT) ----------
# Secreto para firmar los tokens. CAMBIALO en produccion.
JWT_SECRETO=cambia_este_secreto_por_un_texto_largo_y_aleatorio
# Cuanto tiempo vive un token. Ejemplos: 15m, 2h, 7d
JWT_EXPIRACION=2h

# ---------- Reglas de negocio ----------
# Aforo maximo de la discoteca (SAF). Alerta al 90%, bloqueo al 100%.
AFORO_MAXIMO=200
# Porcentaje de IVA aplicado a las ventas.
IVA_PORCENTAJE=16
