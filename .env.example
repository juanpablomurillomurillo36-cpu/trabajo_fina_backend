# =====================================================================
# .env.example  -  Plantilla de variables de entorno
# ---------------------------------------------------------------------
# Este archivo SI se sube a git: no contiene contraseñas reales, solo
# los nombres de las variables y valores de ejemplo.
#
# COMO USARLO:
#   1. Copiar el archivo:   copy .env.example src\.env
#   2. Editar src\.env con los datos reales del equipo.
#
# src/config/env.js valida que existan las obligatorias. Si falta una,
# el servidor NO arranca (fail fast) en lugar de fallar despues con un
# error confuso en la primera peticion.
# =====================================================================

# ---------- Servidor HTTP ----------
PUERTO=3000
NODE_ENV=development

# ---------- Base de datos MySQL ----------
DB_HOST=localhost
DB_PUERTO=3306
DB_USUARIO=discoteca_app
DB_CLAVE=cambiar_por_la_contraseña_real
DB_NOMBRE=discoteca_api
DB_LIMITE_CONEXIONES=10

# ---------- CORS (origenes permitidos, separados por coma) ----------
ORIGENES_PERMITIDOS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# ---------- Autenticación (JWT) - se usa en una fase posterior ----------
JWT_SECRETO=cambiar_esto_en_produccion
JWT_EXPIRACION=2h

# ---------- Reglas de negocio ----------
AFORO_MAXIMO=200
IVA_PORCENTAJE=16
